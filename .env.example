# Local-only template. Copy to .env and fill every required empty value.
# The root .env is ignored by Git; never commit it.
POSTGRES_USER=filevault
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
SECRET_KEY=

# Optional configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SHARE_PUBLIC_BASE_URL=http://localhost:8080
LOGIN_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=10
CHUNK_RATE_LIMIT=120
