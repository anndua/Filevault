# Template for running the API directly on your host, not for Docker Compose.
# Fill in local service credentials before starting FastAPI.
DATABASE_URL=postgresql+psycopg://filevault:SET_A_LOCAL_PASSWORD@localhost:5432/filevaultdb
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=filevault
MINIO_SECURE=false
REDIS_URL=redis://localhost:6379/0
LOGIN_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=10
CHUNK_RATE_LIMIT=120
SHARE_PUBLIC_BASE_URL=http://localhost:8000
